# --- LLM Configuration ---

# API key for your LLM provider (required)
LLM_API_KEY=

# Model name (depends on provider)
LLM_MODEL=google:gemini-2.0-flash

# --- Rate Limiting ---

# Per-IP limits
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Global limits (across all users)
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60

# --- File Upload ---

# Max file upload size in MB (default: 10)
MAX_FILE_SIZE_MB=10
